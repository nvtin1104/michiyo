{
  "include": ["src", "*"],
  "exclude": ["src/service-worker"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "allowJs": true,
    "checkJs": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDirs": [".", "./.svelte-kit/types"]
  }
}
