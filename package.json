{
  "name": "michiyo-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "npm run --workspace=@michiyo/desktop dev",
    "build:desktop": "npm run --workspace=@michiyo/desktop build",
    "tauri": "npm run --workspace=@michiyo/desktop tauri",
    "dev:cloud": "npm run --workspace=@michiyo/cloud dev",
    "dev:admin": "npm run --workspace=@michiyo/admin dev",
    "test:desktop": "npm run --workspace=@michiyo/desktop test"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  }
}
