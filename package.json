{
  "name": "michiyo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:agent && svelte-check --tsconfig ./tsconfig.json && vite build",
    "test": "vitest run",
    "tauri": "node scripts/tauri.mjs",
    "test:ui": "node scripts/verify-ui.mjs",
    "test:mascot": "node scripts/verify-mascot.mjs",
    "test:companions": "node scripts/verify-companions.mjs",
    "test:settings": "node scripts/verify-settings.mjs",
    "format": "prettier --write src scripts *.json *.ts *.js *.html",
    "build:agent": "node scripts/build-agent.mjs && tsc --project agent/tsconfig.json",
    "test:agent": "vitest run agent/runtime.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-autostart": "^2.5.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.0",
    "@tauri-apps/plugin-store": "^2.4.0",
    "dompurify": "^3.3.0",
    "marked": "^17.0.0",
    "pixi.js": "^8.22.0",
    "svelte": "^5.57.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^5.0.5"
  }
}
